/log/*
/config/master.key
# Local dotenv overrides never commit (Hanami::Env loads .env.local and
# .env.<env>.local — real local secrets like an actual GitHub OAuth app)
.env*.local
/storage/
node_modules/
/public/vite*/
# Vite's dev/build cache (tmp/cache/vite/last-build-development.json re-dates
# on every dev boot and build — the I17/I18 integrate trip)
tmp/
