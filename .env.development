# Dev-only overrides — Hanami::Env loads .env.<environment> only when
# HANAMI_ENV matches, so nothing here reaches a test or production boot.
DATABASE_URL=postgres:///kquest_development
SESSION_SECRET=dev-secret-change-in-production-must-be-at-least-64-chars-min-padding-ok
# Dev sign-in without a GitHub OAuth app: `developer` mounts OmniAuth's form
# strategy (assert_developer_allowed! refuses it outside development).
OAUTH_PROVIDERS=github,developer
